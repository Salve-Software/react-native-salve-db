DATABASE_URL=postgres://salve:salve@localhost:5432/salve_db_server

# Set to true to protect /users and /products behind the mock oauth2 flow
# (POST /auth/login, POST /auth/refresh) — used to test the native
# CredentialProvider's refresh-on-401 path from the example app.
REQUIRE_AUTH=false
# How long an access token lives before the native engine gets a 401 and
# triggers a refresh. Kept short on purpose so the refresh is easy to observe.
ACCESS_TOKEN_TTL_MS=20000
